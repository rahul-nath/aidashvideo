*.npz
*.pkl
*.pickle
.cache/
models--*/
.locks/
*.part
*.partial
*.incomplete
*.aria2
*.crdownload
*.download

# ---------------------------------------------------------------------------
# 5. Media: fixtures, previews, exports, frame dumps, raw intermediates, annotation projects, archives
#    (uppercase twins keep a case-sensitive Linux clone in step with this Mac)
# ---------------------------------------------------------------------------
*.mp4
*.MP4
*.m4v
*.mov
*.MOV
*.mkv
*.webm
*.avi
*.mxf
*.nut
*.y4m

# ---------------------------------------------------------------------------
# 6. MLT / FFmpeg derived state and tool logs
#    (MLT XML is derived execution state, never project authority; tests may commit tiny goldens)
# ---------------------------------------------------------------------------
*.mlt
!/tests/**/*.mlt
*.mlt~
*.kdenlive
*.log
*.log.*
!/tests/**/*.log
ffmpeg2pass-*
*_2pass.log*
*.mbtree
*.cutree
*.trf
*.ffindex
*.lwi

# ---------------------------------------------------------------------------
# 7. Durable store, staged blobs, supervisor run files, crash dumps
#    (the canonical store and content-addressed blobs live under .local/var/ or a granted project dir;
#     these are safety nets for databases opened elsewhere. Add the portable snapshot extension here
#     once contracts.md fixes it.)
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.pid
*.sock
*.ips
*.crash
core.[0-9]*
*.trace/
*.gputrace/
*.bak
*.tmp
*.orig
*.rej

# ---------------------------------------------------------------------------
# 8. Secrets, grants, credentials, key material, licensed fonts, local config overlays
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.env
.envrc
/.direnv/
.netrc
secrets/
credentials*.json
*.token
*.pem
*.key
*.p12
*.pfx
*.keychain-db
# fonts are referenced by identity in docs/plan/runtime-profile.json; vendoring one is a license decision
*.ttf
*.otf
*.ttc
*.dfont
# agent and editor local overlays (the shared .claude/settings.json and CLAUDE.md stay tracked)
/.claude/settings.local.json
/.claude/worktrees/
CLAUDE.local.md
*.local.json
*.local.toml

# ---------------------------------------------------------------------------
# 9. macOS host and editor noise
# ---------------------------------------------------------------------------
.DS_Store
._*
__MACOSX/
*.swp
*.swo
*~
.idea/
*.code-workspace
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
!/.vscode/launch.json
!/.vscode/tasks.json

# ---------------------------------------------------------------------------
# 10. UI toolkit (decision pending). Harmless now; extend when the player/chat client is chosen.
#     Web view: add .vite/, *.tsbuildinfo, .eslintcache, test-results/ under the UI workspace.
#     Qt: add *.qm, *.qmlc, *.jsc.
# ---------------------------------------------------------------------------
node_modules/
playwright-report/
blob-report/

# Operator-supplied source tarballs for scripts/build_toolchain_macos.sh (hash-pinned there)
/*.tar
/*.tar.*
/*.zip

# Rootless toolchain, build trees, source caches and admitted model assets (never committed)
/.deps
/.deps/
